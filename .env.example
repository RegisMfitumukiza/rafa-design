# ==============================================================================
# RAFA DESIGN HUB — PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env.local for local testing or configure in Vercel settings.
# ==============================================================================

# Public canonical site URL used by Next metadata & sitemap
# Local: http://localhost:8000
# Production: https://rafa-design.vercel.app (or custom domain https://rafadesign.com)
NEXT_PUBLIC_SITE_URL=http://localhost:8000

# Secret authorization key protecting Vercel Cron endpoints (/api/cron/editorial-reminder)
# Set in Vercel Environment Variables: CRON_SECRET=your_generated_secret_here
CRON_SECRET=

# Contact form email delivery via Resend (https://resend.com)
# Obtain API key from Resend dashboard
RESEND_API_KEY=

# Verified sender domain email for contact inquiries
# e.g. inquiry@rafadesign.com
RESEND_FROM_EMAIL=

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# Mapping (Optional)
NEXT_PUBLIC_MAPBOX_TOKEN=

# ==============================================================================
# SANITY CMS CONFIGURATION
# ==============================================================================

# Sanity Project ID (obtain from sanity.io/manage)
# Example: abc123de
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Sanity Dataset (default: production)
# Use 'production' for live content
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Version (YYYY-MM-DD format)
# Locks API behavior to specific date for consistency
# Default: 2024-08-20 (current at project setup)
NEXT_PUBLIC_SANITY_API_VERSION=2024-08-20

# Sanity Read Token (optional, required for preview/draft mode)
# Obtain from sanity.io/manage → API → Tokens
# Required permissions: Viewer
SANITY_API_READ_TOKEN=

# Sanity Webhook Secret (signature verification for /api/revalidate)
# Generate any random string, e.g. `openssl rand -hex 32`
# Use the SAME value in:
#  - .env.local (local testing)
#  - Vercel Environment Variables (production)
#  - sanity.io/manage → API → Webhooks → Create webhook
#    URL: https://www.rafadesignhub.com/api/revalidate
#    Trigger: create, update, delete (Published Only)
# NOTE: Keep this value private — never commit it to the repository.
SANITY_WEBHOOK_SECRET=

# ==============================================================================
# SANITY STUDIO ACCESS
# ==============================================================================
# Studio URL: yourdomain.com/studio
# Authentication: Configure in Sanity dashboard (sanity.io/manage)
# Default: Owner-only access (single admin)
# ==============================================================================
