{
  "name": "rafa-design-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set TURBOPACK=0 && next dev -p 8000",
    "dev:turbo": "next dev -p 8000",
    "build": "set TURBOPACK=0 && next build",
    "build:turbo": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:images": "node scripts/generate-placeholder-images.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "migrate:journal": "node scripts/migrate-journal-to-sanity.mjs",
    "migrate:services": "node scripts/migrate-services-to-sanity.mjs",
    "migrate:team": "node scripts/migrate-team-to-sanity.mjs",
    "migrate:studio": "node scripts/migrate-studio-to-sanity.mjs",
    "migrate:careers": "node scripts/migrate-careers-to-sanity.mjs",
    "migrate:contact": "node scripts/migrate-contact-to-sanity.mjs",
    "migrate:site-settings": "node scripts/migrate-site-settings-to-sanity.mjs",
    "migrate:team-categories": "node scripts/migrate-team-categories.mjs",
    "migrate:process": "node scripts/seed-process-page.mjs",
    "migrate:sustainability": "node scripts/migrate-sustainability-to-sanity.mjs",
    "migrate:align-singletons": "node scripts/align-singleton-ids.mjs",
    "migrate:seed-page-intros": "node scripts/seed-page-intros.mjs",
    "migrate:remove-site-settings-contact": "node scripts/remove-site-settings-contact.mjs",
    "migrate:fix-typology": "node scripts/fix-project-typology-strings.mjs",
    "migrate:company": "npm run migrate:team && npm run migrate:studio && npm run migrate:process && npm run migrate:careers && npm run migrate:contact && npm run migrate:site-settings",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run build",
    "audit": "check-audit",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@hookform/resolvers": "^5.4.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^6.29.1",
    "@sanity/vision": "^5.31.2",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.25.0",
    "next": "16.3.8",
    "next-sanity": "^13.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "resend": "^6.18.0",
    "sanity": "^5.31.2",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "dompurify": "^3.4.16",
    "fast-uri": "^3.1.7",
    "markdown-it": "^14.3.2",
    "postcss": "^8.5.21",
    "sharp": "^0.35.4",
    "minimatch@10": {
      "brace-expansion": "^5.0.12"
    },
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    },
    "jsdom": {
      "undici": "^7.29.1"
    },
    "@actions/http-client": {
      "undici": "^6.28.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-audit-resolver": "^3.0.0-RC.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,mjs,yml,yaml}": [
      "prettier --write"
    ]
  }
}
